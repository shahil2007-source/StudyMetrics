# StudyMetrics Environment Configuration
# Copy this file to .env and configure your MongoDB Atlas connection details.

# MongoDB Atlas Connection URI (Optional)
# If left empty or invalid, StudyMetrics automatically uses local CSV fallback storage (data/sample_students.csv).
MONGODB_URI=mongodb+sandbox.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name
MONGODB_DB_NAME=studymetrics

# MongoDB Collection Name
MONGODB_COLLECTION=students
